# Copy this file to supabase/functions/.env (gitignored via the `.env` pattern).
# In production set the same names with `supabase secrets set`.
# These local values are not real Meta credentials; the adapter stays inert until they are present.
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_APP_SECRET=local-dev-secret

# Blog translator (spec 017, ADR-0005). From the Edge Runtime container the host is
# host.docker.internal. Without LIBRETRANSLATE_URL the function answers TRANSLATION_UNAVAILABLE.
LIBRETRANSLATE_URL=http://host.docker.internal:5050
# Only if the LibreTranslate server requires API keys.
LIBRETRANSLATE_API_KEY=
